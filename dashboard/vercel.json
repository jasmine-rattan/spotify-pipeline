{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.json" },
    { "source": "/api/metrics", "destination": "/api/metrics.json" },
    { "source": "/api/issues", "destination": "/api/issues.json" },
    { "source": "/api/ranking", "destination": "/api/ranking.json" },
    { "source": "/api/recommendations", "destination": "/api/recommendations.json" }
  ]
}
